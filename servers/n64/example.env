# Nextendo VPS template: empty fields must be provisioned by the operator.
NPLN_DEPLOYMENT=nextendo
NPLN_LISTEN=0.0.0.0:443
CERT_FILE=cert.pem
KEY_FILE=key.pem
NPLN_CERT_PROFILE=observed
NPLN_ALLOW_LEGACY_SIGNER=0
# Internal account service destination; not advertised to clients.
NEXTENDO_ACCOUNT_URL=
NEXTENDO_SECRET=
NEXTENDO_INTERNAL_KEY=
NPLN_JWT_KEY=npln_jwt_n64_es256.key
# Operator-assigned public IPv4 destinations. Never LAN or wildcard addresses.
NPLN_GAMESESSION_HOST=
NPLN_GAMESESSION_PORT=443
NPLN_LATENCY_HOST=
NPLN_LATENCY_PORT=443
# Listener interfaces and advertised endpoints are separate.
NPLN_STUN_LISTEN=0.0.0.0:3478
NPLN_STUN_HOST=
NPLN_STUN_PORT=3478
NPLN_TURN_LISTEN=0.0.0.0:3479
NPLN_TURN_HOST=
NPLN_TURN_PORT=3479
NPLN_TURN_RELAY_IP=
NPLN_TURN_REALM=
NPLN_TURN_USERNAME=
NPLN_TURN_PASSWORD=
# Two distinct public IPv4 addresses assigned to the host; direct binds.
NPLN_NNCS_ENABLED=1
NEXTENDO_NNCS1_IP=
NEXTENDO_NNCS2_IP=
NPLN_NNCS_LOCAL_IP=
# Keep protocol traces private; disable the passive UDP observer.
WONDER_PROBE_DIR=data
NPLN_UDP_OBSERVE_ADDRS=off
NPLN_UNKNOWN_RPC_MODE=unimplemented
NPLN_MAX_MESSAGE_BYTES=33554432
NPLN_TLS_HANDSHAKE_TIMEOUT=10s
