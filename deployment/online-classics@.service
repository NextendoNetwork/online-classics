[Unit]
Description=Nextendo Classics staging service (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=online-classics
Group=online-classics
WorkingDirectory=/opt/online-classics
EnvironmentFile=/etc/online-classics/%i/service.env
ExecStart=/opt/online-classics/%i -deployment nextendo -config /etc/online-classics/%i/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
MemoryMax=256M
TasksMax=64
LimitNOFILE=2048
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
